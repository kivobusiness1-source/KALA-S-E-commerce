# ============================================
# KALA'S - Variables d'environnement
# ============================================

# --- DÉVELOPPEMENT LOCAL (SQLite) ---
# Utilisé uniquement en développement local dans le sandbox
DATABASE_URL=file:/home/z/my-project/db/custom.db
DIRECT_URL=file:/home/z/my-project/db/custom.db

# --- PRODUCTION VERCEL (PostgreSQL) ---
# Décommenter et remplir pour la production sur Vercel
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DIRECT_URL=postgresql://user:password@host:5432/database?sslmode=require
#
# ⚠️ IMPORTANT :
# - DATABASE_URL = URL de connexion poolée (Prisma Accelerate / Vercel Postgres)
# - DIRECT_URL = URL de connexion directe (pour les migrations)
# - Ne JAMAIS utiliser NEXT_PUBLIC_ pour ces variables
# - Ne JAMAIS committer ces valeurs dans Git
