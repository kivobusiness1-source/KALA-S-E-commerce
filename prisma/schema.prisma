generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ==================== ADMIN AUTH ====================

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  phone     String?
  role      String   @default("staff") // super_admin, admin, staff
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions             AdminSession[]
  stockHistories       StockHistory[]
  createdOrders        Order[]              @relation("assignedBy")
  createdWholesaleOrders WholesaleOrder[]  @relation("wholesaleAssignedBy")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ==================== PRODUCTS ====================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  longDescription String?
  price           Float                          // Prix détail (FCFA)
  comparePrice    Float?                         // Prix barré
  wholesalePrice  Float?                         // Prix gros (FCFA)
  packSize        Int?                           // Taille pack (ex: 12 bouteilles, 10 bidons)
  packPrice       Float?                         // Prix du pack (FCFA)
  commissionPerUnit Float?                       // Commission partenaire par unité (FCFA) — fallback
  commissionMonth1PerUnit Float?                 // Commission 1er mois par unité (FCFA)
  commissionMonth2PlusPerUnit Float?              // Commission mois 2+ par unité (FCFA)
  categoryId      String
  image           String?
  images          String    @default("[]")       // JSON array of image URLs
  volume          String?                       // e.g. "750ml", "2.5L", "5L"
  unit            String    @default("bouteille") // bouteille, bidon, sachet
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  inStock         Boolean   @default(true)
  stockQty        Int       @default(0)
  minStockAlert   Int       @default(10)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        Category  @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  orderItems      OrderItem[]
  reviews         Review[]
  stockHistories  StockHistory[]
  commissions     Commission[]
  affiliateProductTracks AffiliateProductTrack[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  name              String                        // ex: "Citron", "Pomme", "Fraise"
  slug              String                        // ex: "citron", "pomme", "fraise"
  price             Float                         // Prix détail (override parent si défini)
  wholesalePrice    Float?                        // Prix gros (override parent si défini)
  packPrice         Float?                        // Prix pack (override parent si défini)
  commissionPerUnit Float?                        // Commission par unité (override parent si défini) — fallback
  commissionMonth1PerUnit Float?                  // Commission 1er mois par unité (override parent)
  commissionMonth2PlusPerUnit Float?               // Commission mois 2+ par unité (override parent)
  image             String?
  inStock           Boolean  @default(true)
  stockQty          Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  commissions       Commission[]

  @@unique([productId, slug])
  @@index([productId])
  @@index([isActive])
}

// ==================== ORDERS ====================

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerName   String
  customerEmail  String
  customerPhone  String?
  address        String
  city           String      @default("Pointe-Noire")
  status         String      @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  totalAmount    Float
  notes          String?
  deliveryZone   String?
  assignedToId   String?
  assignedBy     Admin?      @relation("assignedBy", fields: [assignedToId], references: [id])
  delivererId    String?
  deliverer      Deliverer?  @relation(fields: [delivererId], references: [id])
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  affiliateCode  String?     // Code promo partenaire utilisé
  affiliateId    String?     // ID du partenaire (pour requêtes rapides)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  orderNotes     OrderNote[]
  commissions    Commission[]

  @@index([assignedToId])
  @@index([delivererId])
  @@index([status])
  @@index([customerId])
  @@index([affiliateCode])
  @@index([affiliateId])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  variantId        String?                     // ProductVariant ID (si applicable)
  productName      String
  variantName      String?                     // ex: "Citron", "Pomme"
  quantity         Int                         // Quantité commandée (packs ou unités)
  unitPrice        Float                       // Prix unitaire appliqué
  totalPrice       Float                       // quantity × unitPrice
  isPack           Boolean  @default(false)    // Vrai si c'est une vente par pack
  packSize         Int?                        // Taille du pack (ex: 12, 10)
  totalUnits       Int?                        // Quantité réelle d'unités (quantity × packSize si pack)
  commissionPerUnit Float?                     // Commission par unité (FCFA) — snapshot au moment de la vente
  commissionTotal   Float?                     // Commission totale pour cet item
  affiliateCode   String?                      // Code promo partenaire (snapshot)
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  commission      Commission?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ==================== COMMISSION SYSTEM ====================

model Commission {
  id              String    @id @default(cuid())
  affiliateId     String
  orderId         String
  orderItemId     String?   @unique                  // Lien vers l'OrderItem spécifique
  affiliateCode   String                      // Code promo utilisé (snapshot)
  productId       String
  variantId       String?                     // ProductVariant ID
  productName     String                      // Nom du produit (snapshot)
  variantName     String?                     // Variante (snapshot)
  quantity        Int                         // Quantité d'unités vendues
  unitPrice       Float                       // Prix unitaire de vente (snapshot)
  totalSaleAmount Float                       // Montant total de la vente pour cet item
  commissionPerUnit Float                     // Commission par unité (snapshot — calculée serveur)
  commissionTotal   Float                     // Commission totale (quantity × commissionPerUnit)
  status          String    @default("pending") // pending, validated, paid, cancelled
  validatedAt     DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  commissionMonth  Int?                          // Mois de commission (1 = premier mois, 2+ = mois suivants)

  @@index([affiliateId])
  @@index([orderId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// ==================== CUSTOMER MESSAGES ====================

model Conversation {
  id            String    @id @default(cuid())
  sessionId     String    @unique
  customerName  String?
  customerEmail String?
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  content        String
  senderType     String       // customer, admin
  isAdminRead    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==================== EMAIL SUBSCRIBERS ====================

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("website")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==================== CONTACT FORM ====================

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==================== SITE SETTINGS ====================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  updatedAt DateTime @updatedAt
}

// ==================== ACTIVITY LOG ====================

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ==================== PRODUCT REVIEWS ====================

model Review {
  id           String   @id @default(cuid())
  productId    String
  customerId   String?
  customerName String
  rating       Int
  comment      String?
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id])

  @@index([productId])
}

// ==================== STOCK HISTORY ====================

model StockHistory {
  id           String   @id @default(cuid())
  productId    String
  previousQty  Int
  newQty       Int
  changeReason String?
  adminId      String?
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id])
  admin        Admin?   @relation(fields: [adminId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

// ==================== LOYALTY POINTS ====================

model LoyaltyPoint {
  id          String   @id @default(cuid())
  email       String
  points      Int      @default(0)
  orderId     String?
  description String?
  createdAt   DateTime @default(now())

  @@index([email])
}

// ==================== ORDER NOTES / REPLIES ====================

model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  content    String
  senderType String   @default("admin")
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ==================== DELIVERER (LIVREUR) ====================

model Deliverer {
  id                String   @id @default(cuid())
  name              String
  phone             String   @unique
  email             String?
  zone              String?
  vehicle           String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orders            Order[]
  wholesaleOrders   WholesaleOrder[]
  sessions          DelivererSession[]

  @@index([zone])
  @@index([isActive])
}

model DelivererSession {
  id          String    @id @default(cuid())
  delivererId String
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  deliverer   Deliverer @relation(fields: [delivererId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ==================== ADVERTISING / CATCHPHRASES ====================

model Catchphrase {
  id        String   @id @default(cuid())
  text      String
  position  String   @default("hero")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([isActive])
}

// ==================== WHOLESALE (COMMANDES EN GROS) ====================

model WholesaleProduct {
  id            String   @id @default(cuid())
  name          String
  description   String?
  lotSize       Int
  lotUnit       String   @default("bouteilles")
  pricePerLot   Float
  comparePrice  Float?
  image         String?
  isActive      Boolean  @default(true)
  minLots       Int      @default(5)
  stockLots     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orderItems    WholesaleOrderItem[]

  @@index([isActive])
}

model WholesaleOrder {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  trackingCode    String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  companyName     String?
  nif             String?
  stat            String?
  address         String
  city            String      @default("Brazzaville")
  quartier        String?
  status          String      @default("pending")
  totalAmount     Float
  notes           String?
  paymentMethodId String?
  paymentMethod   WholesalePaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentStatus   String      @default("unpaid")
  paymentRef      String?
  paymentProof    String?
  deliveryAddress String?
  deliveryZone    String?
  delivererId     String?
  deliverer       Deliverer?  @relation(fields: [delivererId], references: [id])
  assignedToId    String?
  assignedBy      Admin?      @relation("wholesaleAssignedBy", fields: [assignedToId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           WholesaleOrderItem[]
  orderNotes      WholesaleOrderNote[]

  @@index([trackingCode])
  @@index([status])
  @@index([paymentMethodId])
  @@index([assignedToId])
}

model WholesaleOrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  wholesaleProductId  String
  productName         String
  lotsQuantity        Int
  lotSize             Int
  lotUnit             String
  totalUnits          Int
  pricePerLot         Float
  totalPrice          Float
  order               WholesaleOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             WholesaleProduct      @relation(fields: [wholesaleProductId], references: [id])

  @@index([orderId])
}

model WholesaleOrderNote {
  id         String   @id @default(cuid())
  orderId    String
  content    String
  senderType String   @default("admin")
  createdAt  DateTime @default(now())
  order      WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model WholesalePaymentMethod {
  id          String   @id @default(cuid())
  name        String
  description String?
  accountInfo String?
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  isCash      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      WholesaleOrder[]

  @@index([isActive])
}

// ==================== CUSTOMER AUTH ====================

model Customer {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  password      String
  address       String?
  city          String    @default("Pointe-Noire")
  quartier      String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  affiliateId   String?   @unique
  affiliate     Affiliate? @relation("customerAffiliate", fields: [affiliateId], references: [id])
  referredById  String?
  referredBy    Affiliate? @relation("referredCustomers", fields: [referredById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      CustomerSession[]
  orders        Order[]
  reviews       Review[]
  referrals     AffiliateReferral[]

  @@index([email])
  @@index([referredById])
}

model CustomerSession {
  id        String   @id @default(cuid())
  customerId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ==================== AFFILIATE / PARTNER SYSTEM ====================

model Affiliate {
  id              String    @id @default(cuid())
  code            String    @unique // Code promo unique (ex: "ALDI001", "KALA-MARIAM")
  name            String
  email           String    @unique
  phone           String?
  password        String
  company         String?
  commissionRate  Float     @default(5.0) // Taux global (%) — peut être overridden per-produit
  bankInfo        String?
  isActive        Boolean   @default(true)
  totalEarnings   Float     @default(0)
  pendingEarnings Float     @default(0)
  paidEarnings    Float     @default(0)
  totalReferrals  Int       @default(0)
  totalOrders     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer?  @relation("customerAffiliate")
  referredCustomers Customer[] @relation("referredCustomers")
  referrals       AffiliateReferral[]
  payouts         AffiliatePayout[]
  fundTransferRequests FundTransferRequest[]
  sessions        AffiliateSession[]
  commissions     Commission[]
  productTracks   AffiliateProductTrack[]

  @@index([code])
  @@index([isActive])
}

model AffiliateSession {
  id          String    @id @default(cuid())
  affiliateId String
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([token])
}

model AffiliateReferral {
  id            String    @id @default(cuid())
  affiliateId   String
  customerId    String    // Client référé
  orderId       String?   // Première commande
  orderAmount   Float     @default(0)
  commission    Float     @default(0)
  status        String    @default("pending") // pending, earned, paid, cancelled
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([customerId])
  @@index([status])
}

model AffiliatePayout {
  id            String    @id @default(cuid())
  affiliateId   String
  amount        Float
  method        String    // "mobile_money", "bank_transfer", "cash"
  reference     String?
  status        String    @default("pending") // pending, completed, failed
  notes         String?
  createdAt     DateTime  @default(now())
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
}

model FundTransferRequest {
  id                String    @id @default(cuid())
  affiliateId       String
  amount            Float
  method            String    @default("mobile_money") // "mobile_money", "bank_transfer", "cash"
  phoneNumber       String?   // Numéro pour mobile money
  bankInfo          String?   // Infos bancaires
  status            String    @default("pending") // pending, scheduled, processing, completed, failed, rejected
  scheduledAt       DateTime  // Date d'exécution (createdAt + 2h)
  processedAt       DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
  @@index([scheduledAt])
}

// ==================== AFFILIATE PRODUCT TRACKING ====================

// Tracks when an affiliate first earned commission on a specific product FOR A SPECIFIC CUSTOMER.
// Each new customer referred by the same affiliate starts at month 1 commission rate.
// Used to determine if we're in month 1 or month 2+ for tiered commissions.

model AffiliateProductTrack {
  id                String   @id @default(cuid())
  affiliateId       String
  productId         String
  customerId        String   // Each customer gets their own commission month progression
  firstCommissionAt DateTime // Date of first commission for this affiliate+product+customer
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  affiliate         Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, productId, customerId])
  @@index([affiliateId])
  @@index([productId])
  @@index([customerId])
}

// ==================== ENTERPRISE / BUSINESS DATA ====================

model Contract {
  id            String    @id @default(cuid())
  title         String
  description   String?
  type          String    @default("service") // service, partnership, supply, distribution
  status        String    @default("draft") // draft, active, expired, terminated
  ownerId       String
  ownerType     String    // "customer" or "affiliate"
  value         Float     @default(0)
  startDate     DateTime?
  endDate       DateTime?
  terms         String?
  documentUrl   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ownerId])
  @@index([ownerType])
  @@index([status])
}

model BusinessProfile {
  id                  String    @id @default(cuid())
  ownerId             String    @unique
  ownerType           String    // "customer" or "affiliate"
  businessName        String?
  businessType        String?
  registrationNumber  String?
  nif                 String?
  stat                String?
  rccm                String?
  businessEmail       String?
  businessPhone       String?
  website             String?
  businessAddress     String?
  businessCity        String?
  businessCountry     String    @default("Congo")
  description         String?
  logoUrl             String?
  isVerified          Boolean   @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([ownerId])
  @@index([ownerType])
}
