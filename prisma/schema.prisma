generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== ADMIN AUTH ====================

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  phone     String?
  role      String   @default("staff") // super_admin, admin, staff
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions       AdminSession[]
  stockHistories StockHistory[]
  createdOrders  Order[]       @relation("assignedBy")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ==================== PRODUCTS ====================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  longDescription String?
  price       Float
  comparePrice Float?
  categoryId  String
  image       String?
  images      String    @default("[]") // JSON array of image URLs
  volume      String?   // e.g. "1L", "5L", "10L"
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  inStock     Boolean   @default(true)
  stockQty    Int       @default(0)
  minStockAlert Int     @default(10)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category  @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  reviews        Review[]
  stockHistories StockHistory[]
}

// ==================== ORDERS ====================

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerName   String
  customerEmail  String
  customerPhone  String?
  address        String
  city           String      @default("Pointe-Noire")
  status         String      @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  totalAmount    Float
  notes          String?
  deliveryZone   String?
  assignedToId   String?
  assignedBy     Admin?      @relation("assignedBy", fields: [assignedToId], references: [id])
  delivererId    String?
  deliverer      Deliverer?  @relation(fields: [delivererId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  orderNotes     OrderNote[]

  @@index([assignedToId])
  @@index([delivererId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ==================== CUSTOMER MESSAGES ====================

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @unique // Browser fingerprint / session ID
  customerName String?
  customerEmail String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  content        String
  senderType     String       // customer, admin
  isAdminRead    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==================== EMAIL SUBSCRIBERS ====================

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("website") // website, order, contact
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==================== CONTACT FORM ====================

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==================== SITE SETTINGS ====================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string") // string, number, boolean, json
  updatedAt DateTime @updatedAt
}

// ==================== ACTIVITY LOG ====================

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ==================== PRODUCT REVIEWS ====================

model Review {
  id          String   @id @default(cuid())
  productId   String
  customerName String
  rating      Int      // 1-5
  comment     String?
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ==================== STOCK HISTORY ====================

model StockHistory {
  id           String   @id @default(cuid())
  productId    String
  previousQty  Int
  newQty       Int
  changeReason String?
  adminId      String?
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  admin   Admin?   @relation(fields: [adminId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

// ==================== LOYALTY POINTS ====================

model LoyaltyPoint {
  id          String   @id @default(cuid())
  email       String
  points      Int      @default(0)
  orderId     String?
  description String?
  createdAt   DateTime @default(now())

  @@index([email])
}

// ==================== ORDER NOTES / REPLIES ====================

model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  content    String
  senderType String   @default("admin") // admin, system
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ==================== DELIVERER (LIVREUR) ====================

model Deliverer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  zone        String?  // Zone de livraison (ex: Centre-ville, Loandjili)
  vehicle     String?  // Type de véhicule (moto, vélo, camionnette)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([zone])
  @@index([isActive])
}

// ==================== ADVERTISING / CATCHPHRASES ====================

model Catchphrase {
  id        String   @id @default(cuid())
  text      String
  position  String   @default("hero") // hero, promo_bar, product_page, footer
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([isActive])
}

// ==================== REMOVED OLD MODELS ====================
// User and Post models have been replaced with the above business models.
