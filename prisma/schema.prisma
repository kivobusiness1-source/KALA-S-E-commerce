generator client {
  provider = "prisma-client-js"
}

datasource db {
  // ╔══════════════════════════════════════════════════════════════╗
  // ║  DÉVELOPPEMENT LOCAL → sqlite                              ║
  // ║  PRODUCTION VERCEL  → postgresql (changer provider + url)   ║
  // ╚══════════════════════════════════════════════════════════════╝
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== ADMIN AUTH ====================

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  phone     String?
  role      String   @default("staff") // super_admin, admin, staff
  isActive   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions       AdminSession[]
  stockHistories StockHistory[]
  createdOrders  Order[]       @relation("assignedBy")
  createdWholesaleOrders WholesaleOrder[] @relation("wholesaleAssignedBy")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ==================== PRODUCTS ====================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  longDescription String?
  price       Float
  comparePrice Float?
  categoryId  String
  image       String?
  images      String    @default("[]") // JSON array of image URLs
  volume      String?   // e.g. "1L", "5L", "10L"
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  inStock     Boolean   @default(true)
  stockQty    Int       @default(0)
  minStockAlert Int     @default(10)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category  @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  reviews        Review[]
  stockHistories StockHistory[]
}

// ==================== ORDERS ====================

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerName   String
  customerEmail  String
  customerPhone  String?
  address        String
  city           String      @default("Pointe-Noire")
  status         String      @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  totalAmount    Float
  notes          String?
  deliveryZone   String?
  assignedToId   String?
  assignedBy     Admin?      @relation("assignedBy", fields: [assignedToId], references: [id])
  delivererId    String?
  deliverer      Deliverer?  @relation(fields: [delivererId], references: [id])
  customerId     String?     // Customer who placed the order (if logged in)
  customer       Customer?   @relation(fields: [customerId], references: [id])
  affiliateCode  String?     // Affiliate code used in this order
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  orderNotes     OrderNote[]
  referral       AffiliateReferral?

  @@index([assignedToId])
  @@index([delivererId])
  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ==================== CUSTOMER MESSAGES ====================

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @unique // Browser fingerprint / session ID
  customerName String?
  customerEmail String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  content        String
  senderType     String       // customer, admin
  isAdminRead    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==================== EMAIL SUBSCRIBERS ====================

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("website") // website, order, contact
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==================== CONTACT FORM ====================

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==================== SITE SETTINGS ====================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string") // string, number, boolean, json
  updatedAt DateTime @updatedAt
}

// ==================== ACTIVITY LOG ====================

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ==================== PRODUCT REVIEWS ====================

model Review {
  id          String   @id @default(cuid())
  productId   String
  customerId  String?  // If review is from a logged-in customer
  customerName String
  rating      Int      // 1-5
  comment     String?
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id])

  @@index([productId])
}

// ==================== STOCK HISTORY ====================

model StockHistory {
  id           String   @id @default(cuid())
  productId    String
  previousQty  Int
  newQty       Int
  changeReason String?
  adminId      String?
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  admin   Admin?   @relation(fields: [adminId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

// ==================== LOYALTY POINTS ====================

model LoyaltyPoint {
  id          String   @id @default(cuid())
  email       String
  points      Int      @default(0)
  orderId     String?
  description String?
  createdAt   DateTime @default(now())

  @@index([email])
}

// ==================== ORDER NOTES / REPLIES ====================

model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  content    String
  senderType String   @default("admin") // admin, system
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ==================== DELIVERER (LIVREUR) ====================

model Deliverer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  zone        String?  // Zone de livraison (ex: Centre-ville, Loandjili)
  vehicle     String?  // Type de véhicule (moto, vélo, camionnette)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  wholesaleOrders WholesaleOrder[]

  @@index([zone])
  @@index([isActive])
}

// ==================== ADVERTISING / CATCHPHRASES ====================

model Catchphrase {
  id        String   @id @default(cuid())
  text      String
  position  String   @default("hero") // hero, promo_bar, product_page, footer
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([isActive])
}

// ==================== WHOLESALE (COMMANDES EN GROS) ====================

model WholesaleProduct {
  id            String   @id @default(cuid())
  name          String
  description   String?
  lotSize       Int      // Number of units per lot (e.g., 10 bottles for liquid soap)
  lotUnit       String   @default("bouteilles") // Unit name: bouteilles, bidons, sachets, etc.
  pricePerLot   Float    // Price per lot in FCFA
  comparePrice  Float?   // Compare/strikethrough price per lot
  image         String?
  isActive      Boolean  @default(true)
  minLots       Int      @default(5) // Minimum number of lots per order
  stockLots     Int      @default(0) // Available stock in lots
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orderItems    WholesaleOrderItem[]

  @@index([isActive])
}

model WholesaleOrder {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // e.g., GRO-XXXXXX
  trackingCode    String      @unique // Code for customer to track order
  // Customer info
  customerName    String
  customerEmail   String
  customerPhone   String
  companyName     String?     // Company / business name
  nif             String?     // NIF (Numéro d'Identification Fiscale)
  stat            String?     // STAT
  address         String
  city            String      @default("Brazzaville")
  quartier        String?     // Neighborhood
  // Order details
  status          String      @default("pending") // pending, confirmed, processing, ready, shipped, delivered, cancelled
  totalAmount     Float
  notes           String?
  // Payment
  paymentMethodId String?
  paymentMethod   WholesalePaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentStatus   String      @default("unpaid") // unpaid, partial, paid
  paymentRef      String?     // Payment reference/transaction ID
  paymentProof    String?     // Uploaded proof of payment (image URL)
  // Delivery
  deliveryAddress String?     // If different from address
  deliveryZone    String?
  delivererId     String?
  deliverer       Deliverer?  @relation(fields: [delivererId], references: [id])
  // Admin
  assignedToId    String?
  assignedBy      Admin?      @relation("wholesaleAssignedBy", fields: [assignedToId], references: [id])
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           WholesaleOrderItem[]
  orderNotes      WholesaleOrderNote[]

  @@index([trackingCode])
  @@index([status])
  @@index([paymentMethodId])
  @@index([assignedToId])
}

model WholesaleOrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  wholesaleProductId  String
  productName         String
  lotsQuantity        Int      // Number of lots
  lotSize             Int      // Units per lot (snapshot)
  lotUnit             String   // Unit name (snapshot)
  totalUnits          Int      // lotsQuantity * lotSize
  pricePerLot         Float    // Price per lot (snapshot)
  totalPrice          Float    // lotsQuantity * pricePerLot
  order               WholesaleOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             WholesaleProduct      @relation(fields: [wholesaleProductId], references: [id])

  @@index([orderId])
}

model WholesaleOrderNote {
  id         String   @id @default(cuid())
  orderId    String
  content    String
  senderType String   @default("admin") // admin, system, customer
  createdAt  DateTime @default(now())
  order      WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model WholesalePaymentMethod {
  id          String   @id @default(cuid())
  name        String   // e.g., "M-Pesa", "Airtel Money", "Espèces"
  description String?  // Instructions or details
  accountInfo String?  // Phone number or account for mobile money
  icon        String?  // Icon name or emoji
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  isCash      Boolean  @default(false) // Whether this is cash payment
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      WholesaleOrder[]

  @@index([isActive])
}

// ==================== CUSTOMER AUTH ====================

model Customer {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  phone       String?
  password    String
  address     String?
  city        String    @default("Pointe-Noire")
  quartier    String?   // Neighborhood
  isActive    Boolean   @default(true)
  emailVerified Boolean @default(false)
  // Affiliate link
  affiliateId String?   @unique // If this customer is also an affiliate
  affiliate   Affiliate? @relation("customerAffiliate", fields: [affiliateId], references: [id])
  // Referral tracking — which affiliate referred this customer
  referredById String?
  referredBy   Affiliate? @relation("referredCustomers", fields: [referredById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    CustomerSession[]
  orders      Order[]
  reviews     Review[]
  referral    AffiliateReferral?

  @@index([email])
  @@index([referredById])
}

model CustomerSession {
  id        String   @id @default(cuid())
  customerId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ==================== AFFILIATE / PARTNER SYSTEM ====================

model Affiliate {
  id              String    @id @default(cuid())
  code            String    @unique // Unique affiliate code (e.g., "KALA-MARIAM")
  name            String    // Partner full name
  email           String    @unique
  phone           String?
  password        String    // Separate login for affiliate dashboard
  company         String?   // Company name
  commissionRate  Float     @default(5.0) // Commission % (e.g., 5.0 = 5%)
  bankInfo        String?   // Bank account or mobile money info for payouts
  isActive        Boolean   @default(true)
  totalEarnings   Float     @default(0)  // Lifetime earnings in FCFA
  pendingEarnings Float     @default(0)  // Unpaid earnings
  paidEarnings    Float     @default(0)  // Already paid out
  totalReferrals  Int       @default(0)  // Total customers referred
  totalOrders     Int       @default(0)  // Total orders from referrals
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Relations
  customer        Customer?  @relation("customerAffiliate")
  referredCustomers Customer[] @relation("referredCustomers")
  referrals       AffiliateReferral[]
  payouts         AffiliatePayout[]
  sessions        AffiliateSession[]

  @@index([code])
  @@index([isActive])
}

model AffiliateSession {
  id          String    @id @default(cuid())
  affiliateId String
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([token])
}

model AffiliateReferral {
  id            String    @id @default(cuid())
  affiliateId   String
  customerId    String    @unique // One referral per customer
  orderId       String?   @unique // First order that triggered the commission
  orderAmount   Float     @default(0) // Amount of the referred order
  commission    Float     @default(0) // Commission earned from this referral
  status        String    @default("pending") // pending, earned, paid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order         Order?    @relation(fields: [orderId], references: [id])

  @@index([affiliateId])
  @@index([status])
}

model AffiliatePayout {
  id            String    @id @default(cuid())
  affiliateId   String
  amount        Float     // Amount paid out in FCFA
  method        String    // "mobile_money", "bank_transfer", "cash"
  reference     String?   // Transaction reference
  status        String    @default("pending") // pending, completed, failed
  notes         String?
  createdAt     DateTime  @default(now())
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([status])
}

// ==================== REMOVED OLD MODELS ====================
// User and Post models have been replaced with the above business models.
