# ============================================
# KALA'S — Variables d'environnement
# ============================================
# ⚠️ NE JAMAIS committer ce fichier avec de vraies valeurs !
# Copier ce fichier en .env et remplir les valeurs réelles.

# ============================================
# BASE DE DONNÉES (Prisma + PostgreSQL)
# ============================================

# DATABASE_URL : URL de connexion poolée
# - En dev local : fichier SQLite
# - En prod Vercel : URL PostgreSQL poolée (Prisma Accelerate / Vercel Postgres)
DATABASE_URL=file:./dev.db

# DIRECT_URL : URL de connexion directe (pour les migrations Prisma)
# - En dev local : même que DATABASE_URL
# - En prod Vercel : URL PostgreSQL directe (sans pooling)
# ⚠️ OBLIGATOIRE pour Vercel + Prisma ! Les migrations ont besoin d'une connexion directe.
DIRECT_URL=file:./dev.db

# Exemple pour Vercel + Supabase :
# DATABASE_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:5432/postgres

# Exemple pour Vercel + Neon :
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Exemple pour Vercel Postgres :
# DATABASE_URL=postgresql://default:password@ep-xxx.region.aws.postgres.vercel-storage.com/verceldb?sslmode=require
# DIRECT_URL=postgresql://default:password@ep-xxx.region.aws.postgres.vercel-storage.com/verceldb?sslmode=require
